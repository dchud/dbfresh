/* Catppuccin Macchiato, wired in via DbfreshApp.theme = "catppuccin-macchiato"
 * (Textual bundles this theme, so $primary/$secondary/$success/$warning/
 * $error/$background/$surface/$panel/$foreground already resolve to
 * mauve/peach/green/yellow/red/base/surface0/surface1/text -- see
 * dbfresh.tui.dashboard._STATUS_STYLE for the Rich-side status colors,
 * which read from the same palette).
 *
 * The variables below fill in the rest of the named Macchiato palette that
 * the bundled theme doesn't expose as $-variables, so any rule in this file
 * (or a future one) can reach the full set by name.
 */
$mantle: #1e2030;
$crust: #181926;
$surface2: #5b6078;
$overlay0: #6e738d;
$overlay1: #8087a2;
$overlay2: #939ab7;
$subtext0: #a5adcb;
$subtext1: #b8c0e0;
$blue: #8aadf4;
$teal: #8bd5ca;
$sky: #91d7e3;

Screen {
    background: $background;
}

Header {
    background: $mantle;
}

Footer {
    background: $mantle;
}

/* Textual's default Button is deliberately chunky: min-width 16 plus a
 * tall raised border top and bottom make every button three rows tall and
 * wide regardless of its label. Across dbfresh's panels (Store prune,
 * Configure) that reads as oversized, so flatten the border to a single
 * row and let the width hug the label. Applies to
 * every button in the app; the per-screen rules below only add
 * inter-button spacing (margin), not size. App CSS overrides the widget's
 * own DEFAULT_CSS by origin, so no !important is needed to beat Textual's
 * more specific -style-default border rules.
 */
Button {
    min-width: 6;
    height: 1;
    border-top: none;
    border-bottom: none;
}

/* Same oversized-by-default problem for the text and dropdown controls:
 * Textual's Input and Select are three rows tall (a tall border top and
 * bottom) and full width, which is far more than the short values this app
 * collects (source/object names, a threshold, a duration) need. Flatten
 * both to a single row, keeping the $surface background so an empty field
 * is still visibly a field -- the same shape Textual's own -textual-compact
 * variant uses. !important is required to beat Textual's more specific
 * :focus / -invalid border rules, which otherwise restore the tall border
 * (and the row height) the moment a control takes focus; the compact focus
 * background-tint still applies, so focus stays visible. Per-field widths
 * live with each screen's rules below; height/flatten is global. */
Input {
    height: 1;
    border: none !important;
    padding: 0 1;
}

Select > SelectCurrent {
    border: none !important;
    padding: 0 1 0 0;
}

/* Every pushed screen's own bold, mixed-case page heading ("Report",
 * "History", "Configure", "Object detail", "Store", "Help") -- see each
 * screen's compose(). Distinct from .section-title (a smaller sub-section
 * label within a panel, e.g. "Existing checks for this object") and from
 * each screen's own Screen.TITLE (what the Header widget shows instead of
 * the app's "dbfresh" while that screen is active) -- the two normally
 * read the same text, but the heading is part of the scrollable body
 * where the Header is not.
 */
.screen-heading {
    color: $foreground;
    text-style: bold;
    padding: 1 1 0 1;
}

/* Both status grids share one cursor treatment: the default block cursor
 * (Textual's DataTable) floods the whole row with $primary (mauve) and
 * forces every cell's foreground to match it, which erases the
 * OK/WARN/FAIL/ERROR/SKIPPED encoding on exactly the row under focus.
 * cursor_foreground_priority="renderable" (set on both DataTable widgets
 * in app.py / screens.py) keeps a status cell's own color, so this rule
 * only recolors the row background to a neutral tone -- a light overlay
 * grey ($overlay1), bright enough against the base background to track
 * clearly while arrowing through the list (a darker surface tone read as
 * too subtle). The label column carries no color of its own, so on the
 * cursor row it falls back to this rule's foreground -- set to the dark
 * $crust so the name reads as an inverted selection against the light
 * bar. Neutral palette tones only: the status colors stay reserved for
 * the glyphs. ID selectors (not a shared class) so this beats the default
 * CSS's own :focus-scoped rule regardless of focus state.
 */
#dashboard-grid > .datatable--cursor,
#object-detail-grid > .datatable--cursor {
    background: $overlay1;
    color: $crust;
}

/* Home dashboard */

/* A config problem (an unset ${VAR} secret), never a check result --
 * color comes from $warning (this theme's own yellow, bundled with
 * catppuccin-macchiato) applied directly here, not by routing through
 * dashboard.status_style/status_glyph, which are reserved for
 * OK/WARN/FAIL/ERROR/SKIPPED on the grid itself. FAIL-red and
 * ERROR-blue never appear on this banner under any circumstance.
 * Hidden (banner.display in app.py) when nothing is missing.
 */
#missing-secrets-banner {
    background: $mantle;
    color: $warning;
    text-style: bold;
    padding: 0 1;
}

/* A committable .env beside the config (env_hygiene.committable_env_file)
 * -- same warning convention as #missing-secrets-banner above: $warning
 * only, never FAIL-red or ERROR-blue. Hidden (banner.display in app.py)
 * when nothing is at risk.
 */
#env-hygiene-banner {
    background: $mantle;
    color: $warning;
    text-style: bold;
    padding: 0 1;
}

/* The label substring-search box (DbfreshApp.action_toggle_search) --
 * narrow rather than Input's own default full-width, since it only ever
 * holds a short "source.object" substring. Hidden (display in app.py)
 * until '/' reveals it.
 */
#grid-search {
    width: 40;
    margin: 1 1 0 1;
}

#dashboard-grid {
    margin: 1 1 0 1;
}

#status-legend {
    color: $subtext0;
    margin: 1 1 0 1;
}

/* What's currently narrowing/reordering the grid (GridView.status_text) --
 * same muted metadata tone as the legend and last-run-line below it, not a
 * status color. Hidden (display in app.py) whenever no filter/search/sort
 * is active, so it never sits there blank.
 */
#view-status {
    color: $subtext0;
    margin: 0 1 0 1;
}

/* Fills as a run's checks complete (DbfreshApp.on_run_progress) -- neutral
 * chrome, never a status color: $accent (this theme's pink) is not one of
 * the OK/WARN/FAIL/ERROR/SKIPPED hexes in dashboard._STATUS_STYLE, unlike
 * the bundled ProgressBar's own default ($primary while filling, $success
 * -- this theme's OK green -- once complete), so both states are
 * overridden here rather than just one. Hidden (display in app.py) except
 * while a run is in progress.
 */
#run-progress {
    margin: 0 1 0 1;
}

#run-progress > Bar > .bar--bar,
#run-progress > Bar > .bar--complete {
    color: $accent;
    background: $surface;
}

/* Same muted metadata tone as the legend above, not a status color --
 * see dbfresh.tui.dashboard.last_run_line. Sits directly under the legend
 * (no top margin of its own) at the same left gutter, so the two read as
 * one grouped block under the grid. Hidden (display in app.py) until a
 * run has completed.
 */
#last-run-line {
    color: $subtext0;
    margin: 0 1 0 1;
}

/* Same muted metadata tone as last-run-line above, not a status color --
 * see dbfresh.tui.dashboard.unobserved_summary. Sits directly under it at
 * the same left gutter. Hidden (display in app.py) when nothing is
 * unobserved.
 */
#unobserved-line {
    color: $subtext0;
    margin: 0 1 0 1;
}

#empty-state {
    width: 100%;
    height: 100%;
    color: $subtext0;
    text-style: italic;
    content-align: center middle;
}

/* Object detail drill-in */

/* The source.object identifier, directly under the screen's own
 * ".screen-heading" ("Object detail") -- a plain subtitle rather than a
 * second bold heading of its own.
 */
#object-detail-heading {
    color: $subtext1;
    padding: 0 1 1 1;
}

#object-detail-grid {
    margin: 1;
}

/* The currently-highlighted check's WARN/FAIL/ERROR detail
 * (ObjectDetailScreen.on_data_table_row_highlighted / _check_detail_text)
 * -- same muted metadata tone as #status-legend/#last-run-line, not a
 * status color. The leading glyph carries its own status color via an
 * inline Rich style set in Python, so only the reason text after it picks
 * up this rule's color. Hidden (display set in Python) whenever the
 * highlighted row has nothing to show: never observed, or OK/SKIPPED.
 */
#check-detail-line {
    color: $subtext0;
    margin: 0 1 1 1;
}

#detail-checks-scroll {
    margin: 0 1 1 1;
}

/* Config is read-only here -- the note above the checks list names the
 * file to edit by hand, in the same muted metadata tone as the legend and
 * check-detail line, not a status color.
 */
#detail-checks-note {
    color: $subtext0;
    margin-bottom: 1;
}

ObjectDetailScreen Horizontal {
    height: auto;
    margin-bottom: 1;
}

ObjectDetailScreen Button {
    margin-right: 1;
}

/* Report / History */

#report-text,
#history-text {
    padding: 1 2;
}

/* Store */

#store-panel {
    margin: 1 2 0 2;
}

StoreScreen Horizontal {
    height: auto;
    margin-bottom: 1;
}

StoreScreen Button {
    margin-right: 1;
}

#store-info {
    margin-bottom: 1;
}

#store-prune-result {
    color: $subtext0;
}

/* Help overlay */

HelpScreen {
    align: center middle;
}

#help-panel {
    width: 64;
    background: $mantle;
    border: round $surface2;
    padding: 1 2;
}

#help-bindings {
    margin-top: 1;
}

#help-legend {
    margin-top: 1;
    color: $subtext0;
}

/* Configure screen */

ConfigureScreen #propose-section {
    padding: 1 2;
}

/* The single-value form fields default to full width, which is far wider
 * than a source name, object name, or timestamp column needs and leaves
 * the screen looking sparse. Cap them at a readable fixed width (a little
 * wider than the Home search box's 40). */
ConfigureScreen #object-input,
ConfigureScreen #timestamp-input,
ConfigureScreen #source-select {
    width: 48;
}

ConfigureScreen Label {
    color: $subtext1;
    margin-top: 1;
}

.hint {
    color: $subtext0;
}

ConfigureScreen Horizontal {
    height: auto;
    margin-bottom: 1;
}

ConfigureScreen Button {
    margin-right: 1;
}

.section-title {
    color: $subtext1;
    text-style: bold;
    margin-top: 1;
}

.panel {
    background: $mantle;
    border: round $surface2;
    padding: 1 2;
    margin-top: 1;
}

/* Proposal YAML modal (ConfigureScreen's Accept) -- read-only text to
 * copy, never a form; centered like the Help overlay but sized to
 * actually show a multi-check YAML block rather than a fixed small panel.
 */
ProposalYamlScreen {
    align: center middle;
}

#proposal-yaml-panel {
    width: 90%;
    height: 80%;
    background: $mantle;
    border: round $surface2;
    padding: 1 2;
}

#proposal-yaml-note {
    color: $subtext0;
    margin-bottom: 1;
}

/* TextArea's own default height: 1fr divides the panel's definite 80%
 * screen height above rather than expanding without bound, so no
 * override is needed here -- unlike a TextArea nested in an auto-height
 * parent (see the Copy/Close row below), where 1fr has nothing to divide.
 */
ProposalYamlScreen Horizontal {
    height: auto;
    margin-top: 1;
    margin-bottom: 0;
}

ProposalYamlScreen Button {
    margin-right: 1;
}
